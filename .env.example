# Copiar a .env y completar. En producción, estos valores NUNCA deben
# quedar en un archivo versionado — usar un Secret Manager.

AVEN_ENV=dev

META_APP_SECRET=cambiar-por-el-app-secret-real-de-meta
META_VERIFY_TOKEN=cambiar-por-un-token-propio-que-tu-eliges

# --- Supabase ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# --- n8n ---
# En Docker Compose esto ya apunta al contenedor correcto por defecto (http://n8n:5678).
N8N_URL=http://n8n:5678

# Cifra las credenciales (tokens de Meta, OpenAI) DENTRO de la base de
# datos de n8n. Genera una nueva UNA sola vez con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Guárdala igual que cualquier otro secreto -- si la pierdes, n8n no
# puede volver a descifrar las credenciales ya guardadas.
N8N_ENCRYPTION_KEY=genera-una-con-el-comando-de-arriba-no-uses-este-texto

# Secreto compartido entre n8n y el contenedor n8n-runner (Task Runner
# externo, donde corre el nodo Code aislado del proceso principal).
# Genera uno distinto al de arriba con el mismo comando.
N8N_RUNNERS_AUTH_TOKEN=genera-otra-distinta-con-el-mismo-comando

# El API key se genera manualmente la primera vez: entra a http://localhost:5678,
# crea tu cuenta owner, ve a Settings > n8n API > Create an API key, y pégala aquí.
N8N_API_KEY=pega-aqui-tu-api-key-generada-en-la-ui-de-n8n

# ID del flujo compartido de buffer de mensajes (templates/00-shared-message-buffer),
# desplegado UNA vez. Lo obtienes al desplegarlo por primera vez contra tu n8n.
N8N_BUFFER_WORKFLOW_ID=

# --- Cifrado a nivel de aplicación ---
# Protege tokens de terceros (Google, etc.) guardados en Supabase. Genera con:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=genera-una-con-el-comando-de-arriba

# --- Google OAuth2 (Calendar) ---
# Crea las credenciales en https://console.cloud.google.com/apis/credentials
# (tipo "Web application", con GOOGLE_OAUTH_REDIRECT_URI como Authorized redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/callback

# Firma el parametro "state" del flujo OAuth -- evita que alguien fuerce el
# callback de Google a vincularse con un tenant que no es el suyo. Genera con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
GOOGLE_OAUTH_STATE_SECRET=genera-una-con-el-comando-de-arriba
